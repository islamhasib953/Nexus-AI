flowchart LR
  upload["Authorized document source"] --> validate["Validate file source and classification"]
  validate --> version["Create document version record"]
  version --> job["Durable ingestion job"]
  job --> extract["Extract clean and normalize text"]
  extract --> chunk["Chunk and enrich metadata"]
  chunk --> embed["Generate embeddings"]
  embed --> index["Qdrant vectors with tenant access version metadata"]
  index --> status["Mark ingestion status"]
  question["Authorized question"] --> filter["Derive server-side authorization filter"]
  filter --> search["Vector or hybrid search"]
  search --> rerank["Optional rerank"]
  rerank --> citedContext["Authorized cited context"]
  citedContext --> answer["Grounded response generation"]
