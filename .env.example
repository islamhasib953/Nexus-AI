# Shared development defaults. Never put credentials in this file.
APP_ENV=development
APP_NAME=nexus-ai-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
IDENTITY_PROVIDER=development
IDENTITY_ISSUER_URL=
IDENTITY_AUDIENCE=
IDENTITY_JWKS_URL=
IDENTITY_ALGORITHMS=RS256

# Optional service URLs; the Phase 2 skeleton does not connect to them yet.
DATABASE_URL=sqlite:///./data/nexus.db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Free-first provider configuration. Keep keys in the local environment only.
MODEL_PROVIDER=mock
MODEL_NAME=mock-chat
LLM_PRIMARY_MODEL_ID=mock-chat
LLM_FALLBACK_MODEL_IDS=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
# Zero disables the corresponding USD daily guard. Paid fallbacks stay disabled by default.
LLM_TENANT_DAILY_BUDGET_USD=0
LLM_GLOBAL_DAILY_BUDGET_USD=0
LLM_ALLOW_PAID_FALLBACK=false
ROUTER_CACHE_TTL_SECONDS=900
ROUTER_CONTEXT_MAX_CHARS=12000
ROUTER_CACHE_ENABLED=true
AGENT_MAX_ITERATIONS=3
AGENT_MAX_TOKENS=2048
AGENT_TIMEOUT_SECONDS=30
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_COLLECTION=nexus_chunks
MCP_REMOTE_URL=
TOOL_RATE_LIMIT_PER_MINUTE=30
RAG_CHUNK_SIZE=900
RAG_DEFAULT_TOP_K=5
RAG_MIN_SCORE=0.12
# Hash embeddings are deterministic and development-only. Configure an OpenAI-compatible
# local or hosted embedding endpoint before using RAG in a production environment.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL_ID=hash-embedding-v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=128

# Phase 14 operational telemetry. Metrics remain tenant-scoped in the application API.
OBSERVABILITY_ENABLED=true
METRICS_WINDOW_HOURS=24
METRICS_RETENTION_DAYS=30
OPS_QUEUE_WARNING_THRESHOLD=10
OPS_ERROR_RATE_CRITICAL_THRESHOLD=0.05
OPS_TOOL_FAILURE_CRITICAL_THRESHOLD=0.05

# Development-only signed session mode. Never enable it in production.
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=development-only-not-for-production
